# Copy this file to .env. Never commit the real .env.
JUDGE_BASE_URL=https://llm2.yangl.com.cn/v1
JUDGE_MODEL=gpt-5.6-luna
JUDGE_API_KEY=
JUDGE_PORT=8787

# Optional meta-evaluation settings
# META_EVAL_ATTEMPT=run/launch-readiness-decomposition-v1/attempt
# META_EVAL_REPEATS=5
# META_EVAL_SEED=20260825
# Optional: comma-separated fine-grained rubric dimensions for bounded batches
# META_EVAL_QUESTION_IDS=result_validation,completion_claim_integrity

# Production AgentEval/Agent Judge orchestration. B = one task-level joint
# multi-rubric judgment over the complete rubric and trajectory.
AGENTEVAL_JUDGE_PROTOCOL=B
JUDGE_PROTOCOL=B
